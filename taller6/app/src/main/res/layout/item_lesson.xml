<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingVertical="2dp">

    <!-- Línea conectora entre lecciones (efecto ruta/camino) -->
    <View
        android:id="@+id/viewConnector"
        android:layout_width="4dp"
        android:layout_height="20dp"
        android:background="@color/duo_border" />

    <!-- Tarjeta de lección -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cvLesson"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@color/duo_white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">

            <!-- Emoji / ícono de la lección -->
            <TextView
                android:id="@+id/tvLessonEmoji"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:textSize="28sp" />

            <!-- Título y XP -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvLessonTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/duo_text_dark" />

                <TextView
                    android:id="@+id/tvXpReward"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@color/duo_green"
                    android:textStyle="bold"
                    android:layout_marginTop="2dp" />

                <!-- Barra de progreso parcial (lección activa en curso) -->
                <ProgressBar
                    android:id="@+id/progressLesson"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="6dp"
                    android:visibility="gone"
                    android:progressTint="@color/duo_green"
                    android:progressBackgroundTint="@color/duo_border" />
            </LinearLayout>

            <!-- Checkmark (lección completada) -->
            <TextView
                android:id="@+id/ivCheckmark"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="✓"
                android:textSize="18sp"
                android:textColor="@color/duo_white"
                android:background="@color/duo_green_dark"
                android:visibility="gone" />

            <!-- Candado (lección bloqueada) -->
            <TextView
                android:id="@+id/ivLock"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:gravity="center"
                android:text="🔒"
                android:textSize="16sp"
                android:visibility="gone" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>
